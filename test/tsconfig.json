{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"lib": [
			"ES2022",
			"DOM"
		],
		"strict": true,
		"skipLibCheck": true,
		"noEmit": true,
		"paths": {
			"vscode": [
				"./vscode-mock.ts"
			]
		},
		"types": [
			"node"
		]
	},
	"include": [
		"./vscode-mock.ts",
		"./*.test.mts",
		"../src/**/*.ts"
	]
}
